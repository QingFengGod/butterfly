{
  "name": "@qingfeng-butterfly/utils",
  "description": "javascript/typescript util functions, zero dependency, any javascript runtime",
  "type": "module",
  "version": "1.0.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["qingfeng-butterfly", "functions library", "utils", "typescript", "javascript"],
  "repository": {
    "type": "git",
    "url": "https://github.com/QingFengGod/butterfly"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "ts-essentials": "^10.0.4"
  },
  "scripts": {
    "build": "tsc && bun run build/index.ts",
    "test": "bun test"
  }
}